---
import Base from '../layouts/Base.astro';
import TeamCell from '../components/TeamCell.astro';
import { loadAll } from '../lib/store';
import { fmt1, teamById, record } from '../lib/format';

const { snapshot: snap, derived } = await loadAll();
const rows = derived?.standings ?? [];
const oddsById = new Map((derived?.odds ?? []).map((o) => [o.teamId, o]));
const playoffTeams = snap?.playoffTeams ?? 6;
const weeksPlayed = derived?.completedWeeks.length ?? 0;
---

<Base title="Standings">
  <div class="page-head">
    <div>
      <div class="eyebrow">{weeksPlayed ? `Through week ${weeksPlayed}` : 'Season not started'}</div>
      <h1>Standings</h1>
      <p>Top {playoffTeams} make the playoffs. <strong>All-play</strong> is your record if you played every team every week; <strong>Luck</strong> is actual wins minus the wins that all-play record says you deserved.</p>
    </div>
  </div>

  {!snap ? (
    <div class="empty">Waiting for the first ESPN sync.</div>
  ) : (
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th></th><th>Team</th><th class="num">W-L</th><th class="num">PF</th><th class="num">PA</th><th class="num">PPG</th>
              <th class="num">All-play</th><th class="num">Exp. W</th><th class="num">Luck</th><th class="num">vs Median</th><th class="num">Playoff %</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((s) => {
              const t = teamById(snap, s.teamId)!;
              const o = oddsById.get(s.teamId);
              return (
                <tr style={s.seed === playoffTeams ? 'border-bottom:2px dashed var(--border-2)' : ''}>
                  <td class="rank-cell">{s.seed}</td>
                  <td><TeamCell team={t} /></td>
                  <td class="num" style="font-weight:700">{record(s)}</td>
                  <td class="num">{fmt1(s.pointsFor)}</td>
                  <td class="num dim">{fmt1(s.pointsAgainst)}</td>
                  <td class="num">{fmt1(s.ppg)}</td>
                  <td class="num">{s.allPlayWins}-{s.allPlayLosses}</td>
                  <td class="num dim">{s.expectedWins.toFixed(1)}</td>
                  <td class:list={['num', s.luck > 0.5 ? 'green' : s.luck < -0.5 ? 'red' : 'dim']} style="font-weight:600">{s.luck > 0 ? '+' : ''}{s.luck.toFixed(1)}</td>
                  <td class="num dim">{s.medianWins}-{weeksPlayed - s.medianWins}</td>
                  <td class="num">{o ? `${Math.round(o.playoff)}%` : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="tiny dim" style="margin:12px 0 0">Seeding: record, then total points (league setting). The dashed line is the playoff cut. Playoff % comes from a {derived?.simRuns?.toLocaleString() ?? '10,000'}-run simulation of the remaining schedule — see <a href="/playoffs">Playoff Odds</a>.</p>
    </div>
  )}
</Base>
