---
import '../styles/global.css';
import TeamLogo from '../components/TeamLogo.astro';
import { getSnapshot } from '../lib/store';

const snap = await getSnapshot();
const teams = [...(snap?.teams ?? [])].sort((a, b) => a.name.localeCompare(b.name));
const next = Astro.url.searchParams.get('next') ?? '/';
const current = Astro.locals.teamId;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Who are you? · {snap?.leagueName ?? 'WSB Generations League'}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
      .gate { min-height: 100vh; display: grid; place-items: center; padding: 40px 20px; }
      .gate-inner { width: 100%; max-width: 980px; }
      .teams { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; margin-top: 24px; }
      .team-btn { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 14px; cursor: pointer; color: var(--text); transition: border-color .15s, transform .15s; }
      .team-btn:hover, .team-btn:focus-visible { border-color: var(--accent); transform: translateY(-1px); outline: none; }
      .team-btn.current { border-color: var(--green); box-shadow: 0 0 0 1px rgba(61,220,151,.35) inset; }
      .team-btn b { display: block; font-size: .98rem; }
      .team-btn small { color: var(--dim); font-size: .78rem; }
      .spectator { margin-top: 20px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; color: var(--muted); font-size: .9rem; }
    </style>
  </head>
  <body>
    <main class="gate">
      <div class="gate-inner">
        <div class="brand" style="margin-bottom:18px"><span class="brand-mark">WSB</span><span>{snap?.leagueName?.replace(/ League$/, '') ?? 'WSB Generations'}</span></div>
        <h1>Who are you?</h1>
        <p class="muted" style="max-width:60ch">Pick your team once. The site will remember you on this device, highlight your team everywhere, and sign your trade-block posts and chat messages. Honor system — pick your own.</p>
        {teams.length === 0 ? (
          <div class="empty">League data isn't loaded yet. <a href="/api/identity?clear=1">Try again</a> in a minute.</div>
        ) : (
          <form method="post" action="/api/identity">
            <input type="hidden" name="next" value={next} />
            <div class="teams">
              {teams.map((t) => (
                <button type="submit" name="team" value={t.id} class:list={['team-btn', { current: current === t.id }]}>
                  <TeamLogo team={t} />
                  <span><b>{t.name}</b><small>{t.owners.join(' & ')}</small></span>
                </button>
              ))}
            </div>
            <div class="spectator">
              <span>Not an owner?</span>
              <button type="submit" name="team" value="0" class="btn secondary sm">Just here to watch</button>
            </div>
          </form>
        )}
      </div>
    </main>
  </body>
</html>
