---
import Base from '../layouts/Base.astro';
import { env } from '../lib/store';

const server = env('DISCORD_SERVER_ID') ?? '';
const channel = env('DISCORD_CHANNEL_ID') ?? '';
const invite = env('DISCORD_INVITE_URL') ?? 'https://discord.gg/sSjCzXFQu';
const widgetReady = Boolean(server && channel);
---

<Base title="League Chat">
  <div class="page-head">
    <div>
      <div class="eyebrow">Discord</div>
      <h1>League Chat</h1>
      <p>The league's Discord, right here. Post as a guest with any name, or sign in with Discord so your messages sync with the app.</p>
    </div>
    <a class="btn secondary" href={invite} target="_blank" rel="noopener">Open in Discord ↗</a>
  </div>

  {widgetReady ? (
    <div class="card" style="padding:0;overflow:hidden">
      <iframe
        src={`https://e.widgetbot.io/channels/${server}/${channel}?api=1`}
        title="League Discord chat"
        allow="clipboard-write; fullscreen"
        style="width:100%;height:min(75vh,760px);border:0;display:block;background:#313338"
      ></iframe>
    </div>
  ) : (
    <div class="card">
      <h2>Chat embed not connected yet</h2>
      <p class="muted">The embedded chat needs the WidgetBot bot added to the Discord server and the server/channel IDs set as <code>DISCORD_SERVER_ID</code> and <code>DISCORD_CHANNEL_ID</code>. Until then, use the invite link above.</p>
      {server && (
        <iframe src={`https://discord.com/widget?id=${server}&theme=dark`} width="100%" height="400" allowtransparency="true" frameborder="0" sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts" title="Discord server widget"></iframe>
      )}
    </div>
  )}
</Base>
