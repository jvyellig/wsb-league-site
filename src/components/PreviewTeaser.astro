---
/** Headline + first sentence or two of an AI preview, linking to the full column. */
import type { AiPreview } from '../lib/previews';
import { cleanText, teaser } from '../lib/previews';
interface Props {
  p: AiPreview;
  compact?: boolean;
}
const { p, compact = false } = Astro.props;
const href = `/matchups/${p.matchupId}`;
---

<div class="preview-teaser">
  <div class="h"><a href={href}>{cleanText(p.headline)}</a></div>
  {!compact && <div class="t">{teaser(cleanText(p.body))}</div>}
  <a class="more" href={href}>Read the full preview →</a>
</div>
